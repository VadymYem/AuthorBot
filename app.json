{
  "name": "AuthorBot",
  "description": "Modular Telegram userbot by Author C",
  "logo": "https://raw.githubusercontent.com/VadymYem/AuthorBot/main/assets/bot_pfp.jpg",
  "keywords": [
    "telegram",
    "userbot",
    "automation",
    "rich-messages"
  ],
  "env": {
    "AUTHORBOT_WEB_USER": {
      "description": "Username for AuthorBot web authentication",
      "value": "authorbot"
    },
    "AUTHORBOT_WEB_PASSWORD": {
      "description": "Password for AuthorBot web authentication",
      "generator": "secret"
    }
  },
  "buildpacks": [
    {
      "url": "https://github.com/heroku/heroku-buildpack-apt"
    },
    {
      "url": "heroku/python"
    }
  ]
}
